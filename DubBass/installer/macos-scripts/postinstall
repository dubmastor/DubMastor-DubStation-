#!/bin/sh
# Pós-instalação do MRDBI-07 no Mac: libera os plugins da quarentena do Gatekeeper,
# remove cópias antigas (Dub Bass) e cópias soltas na pasta do usuário que ficariam
# duplicadas na DAW, e faz o macOS reler a lista de Audio Units (Logic / GarageBand).
NAME="Mastor Reggae Dub Bass Instrument MRDBI-07"
OLD="Dub Bass - Dub Station"
USER_HOME=$(dscl . -read "/Users/$(stat -f%Su /dev/console)" NFSHomeDirectory 2>/dev/null | awk '{print $2}')

for d in "/Library/Audio/Plug-Ins/VST3" "/Library/Audio/Plug-Ins/Components" \
         "$USER_HOME/Library/Audio/Plug-Ins/VST3" "$USER_HOME/Library/Audio/Plug-Ins/Components"; do
  [ -d "$d" ] || continue
  rm -rf "$d/$OLD.vst3" "$d/$OLD.component"
done
if [ -n "$USER_HOME" ]; then
  rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/$NAME.vst3" "$USER_HOME/Library/Audio/Plug-Ins/Components/$NAME.component"
fi

for p in "/Library/Audio/Plug-Ins/VST3/$NAME.vst3" "/Library/Audio/Plug-Ins/Components/$NAME.component" "/Applications/$NAME.app"; do
  [ -e "$p" ] && xattr -dr com.apple.quarantine "$p" 2>/dev/null
done

killall -9 AudioComponentRegistrar 2>/dev/null
exit 0
